# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AGENTIC RAG TRA CỨU PHÁP LUẬT LAO ĐỘNG
# ==============================================================================

# 1. Khóa Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
# Thay chuỗi bên dưới bằng khóa API thật của bạn và đổi tên file này thành .env
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# 2. Tên mô hình Gemini mặc định (tùy chọn: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# 3. Nhà cung cấp LLM mặc định ('gemini', 'mock', hoặc 'auto')
LLM_PROVIDER=gemini
